#!/usr/bin/env bash
# pre-commit hook for god-hand-decomp — a reference implementation of the
# commit-time ratchet.
#
# NOTE: this file is NOT the active hook. The active hook is selected by git's
# core.hooksPath, which does not point at scripts/hooks/. This copy is kept
# only as a version-tracked reference; nothing installs it automatically. To
# enforce the ratchet yourself, run scripts/session_check.sh before committing
# (or install this file as your own pre-commit hook).
#
# Escape hatches (honored only if you install this file as your hook):
#   GODHAND_NO_HOOK=1           skip the hook (env: this commit or your shell)
#   GODHAND_PRECOMMIT_CHECKS=…  run a fast subset, e.g. "build,score,state"
#                               (default: the full session_check.sh suite)
#   git commit --no-verify      bypass once (only for an explicit
#                               ratchet-loosening change)
set -euo pipefail

if [[ -n "${GODHAND_NO_HOOK:-}" ]]; then
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
HARNESS="$ROOT/scripts/session_check.sh"

if [[ ! -x "$HARNESS" ]]; then
    echo "pre-commit: $HARNESS missing or not executable; skipping." >&2
    exit 0
fi

# Optional fast subset; empty/unset runs the full default suite.
CHECKS="${GODHAND_PRECOMMIT_CHECKS:-}"
if [[ -n "$CHECKS" ]]; then
    HARNESS_ARGS=("$CHECKS")
else
    HARNESS_ARGS=()
fi

if ! "$HARNESS" "${HARNESS_ARGS[@]}"; then
    cat >&2 <<'EOF'

pre-commit: session_check.sh failed.

Refusing the commit because the ratchet has regressed.  See output
above for which sub-check failed.  Fix, re-run scripts/session_check.sh
to confirm green, then commit again.

To bypass (only for an explicit ratchet-loosening change):
git commit --no-verify
EOF
    exit 1
fi
